menu "Polysom Application"

    config POLYSOM_TIME_SYNC_TIMEOUT_MS
        int "Serial time-sync timeout (ms)"
        default 30000
        help
            How long to wait at boot for a binary time-sync command on the
            console UART (115200 baud) before giving up and continuing
            without a synced clock. Only used when no DS1307 RTC is fitted
            or its time hasn't been set yet. See components/time_sync and
            tools/set_time.py.

endmenu

menu "Board Configuration"

    config POLYSOM_I2C_SDA_PIN
        int "I2C SDA pin"
        default 2
        help
            GPIO pin number for the shared I2C SDA line.
            NOTE: placeholder pending confirmation against the board schematic —
            previously defaulted to 6, which collided with the SPI MOSI pin.

    config POLYSOM_I2C_SCL_PIN
        int "I2C SCL pin"
        default 3
        help
            GPIO pin number for the shared I2C SCL line.
            NOTE: placeholder pending confirmation against the board schematic —
            previously defaulted to 7, which collided with the SPI CLK pin.

    config POLYSOM_I2C_FREQ_HZ
        int "I2C bus frequency (Hz)"
        default 400000

    config POLYSOM_MMA_ADDR_0
        hex "MMA8451 I2C address (SA0=GND)"
        default 0x1C

    config POLYSOM_MMA_ADDR_1
        hex "MMA8451 I2C address (SA0=VCC)"
        default 0x1D

    config POLYSOM_LDC_ADDR
        hex "LDC1612 I2C address"
        default 0x2B

    config POLYSOM_SDP800_ADDR
        hex "SDP800 I2C address"
        default 0x25

    config POLYSOM_DS1307_ADDR
        hex "DS1307 RTC I2C address"
        default 0x68

    config POLYSOM_RTC_SYNC_INTERVAL_MS
        int "RTC drift-correction interval (ms)"
        default 600000
        help
            How often the system clock is re-synced from the DS1307 RTC, to
            correct drift in the ESP32's internal oscillator. Only takes
            effect if a DS1307 is detected on the I2C bus.

    config POLYSOM_ECG_ADC_CHANNEL
        int "ECG ADC channel number"
        default 0
        help
            ADC1 channel for the ECG (AD8232) analog signal, sampled at
            100 Hz and logged raw for later analysis. GPIO0 = channel 0 on
            ESP32-C6.

    config POLYSOM_SPI_MOSI_PIN
        int "SPI MOSI pin"
        default 18
        help
            GPIO18 = XIAO ESP32C6 D10, the board's default hardware SPI MOSI pin.

    config POLYSOM_SPI_MISO_PIN
        int "SPI MISO pin"
        default 20
        help
            GPIO20 = XIAO ESP32C6 D9, the board's default hardware SPI MISO pin.
            GPIO12/13 are reserved for the native USB Serial/JTAG D-/D+ lines
            used by the console (/dev/ttyACM0) — do not assign them here.

    config POLYSOM_SPI_CLK_PIN
        int "SPI CLK pin"
        default 19
        help
            GPIO19 = XIAO ESP32C6 D8, the board's default hardware SPI SCK pin.

    config POLYSOM_OLED_ADDR
        hex "SH1106 OLED I2C address"
        default 0x3C
        help
            7-bit I2C address of the SH1106 OLED. Shares the sensor I2C bus
            (SDA/SCL above) — no dedicated pins needed. 0x3C is the common
            default for 4-pin SH1106 breakout modules; some are strapped to
            0x3D instead.

    config POLYSOM_OLED_W
        int "OLED width (pixels)"
        default 128

    config POLYSOM_OLED_H
        int "OLED height (pixels)"
        default 64

    config POLYSOM_SD_CS_PIN
        int "SD card CS pin"
        default 21

    config POLYSOM_SD_SPI_FREQ_HZ
        int "SD card SPI frequency (Hz)"
        default 20000000

    config POLYSOM_ECG_RATE_HZ
        int "ECG sample rate (Hz)"
        default 100

    config POLYSOM_SENSOR_RATE_HZ
        int "Sensor sample rate (Hz)"
        default 50

    config POLYSOM_DISPLAY_RATE_HZ
        int "Display refresh rate (Hz)"
        default 5

    config POLYSOM_LOG_RATE_MS
        int "Logger period (ms)"
        default 20

    config POLYSOM_DISPLAY_RATE_MS
        int "Display refresh period (ms)"
        default 200

    config POLYSOM_SLEEP_DURATION_MINS
        int "Deep sleep duration (minutes)"
        default 10

endmenu
