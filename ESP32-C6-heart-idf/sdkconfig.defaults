# Target
CONFIG_IDF_TARGET="esp32c6"

# CPU
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_80=y

# Flash size — chip is ESP32-C6FH4 (4MB embedded flash, per the board schematic)
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"

# Partition table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# NimBLE
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=n
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_NVS_PERSIST=n
CONFIG_BT_NIMBLE_SM_LEGACY=n
CONFIG_BT_NIMBLE_SM_SC=n

# Wi-Fi
CONFIG_ESP_WIFI_ENABLED=y

# FATFS / SD
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255

# Stack sizes
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Logging
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# Console: primary channel is the native USB-Serial/JTAG port. This board's
# only physical connector is USB-C, wired to the chip's native USB peripheral
# (GPIO12/13) — UART0 TX/RX (GPIO16/17) are broken out to a separate,
# unconnected header pin. The panic handler's register/backtrace dump (and
# heap-corruption diagnostics) bypass secondary-console mirroring and only
# write to the primary channel, so with UART0 as primary they were being
# written to a pin nobody can see.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# Serial console / monitor baud rate
CONFIG_ESP_CONSOLE_UART_BAUDRATE=921600
CONFIG_ESPTOOLPY_MONITOR_BAUD=921600

# Polysom application
# Wi-Fi SSID/password are intentionally left unset here — put real
# credentials in sdkconfig.local (gitignored, see sdkconfig.local.example).
CONFIG_POLYSOM_NTP_SERVER="pool.ntp.org"
