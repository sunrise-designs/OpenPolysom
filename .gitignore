# Pipeline outputs. read_log.py writes the .zarr working store and its
# meta.json/events.json sidecars here (export_zarr.DEFAULT_OUT_DIR); meta.json may
# carry a subject.pii block, so the patterns below are deliberately by SHAPE, not by
# exact filename — a timestamped biometric_<date>_meta.json used to slip past the
# exact-name rules and get committed. Never narrow these back to literal names.
/data_scratchpad/
*_meta.json
/events.json

src_python/netlify.json
src_python/patient.json
src_python/biometric_filtered.json
.vscode/c_cpp_properties.json
.github/workflows/clean-machine-test.yml
ESP32-C6-heart-idf/reference/ESP32-C6-LCD-1.47-Test/
src_rust/polysom_rtdi/target

# sdkconfig is a generated file (from sdkconfig.defaults + Kconfig via
# menuconfig) — sdkconfig.defaults is the source of truth, so this is untracked.
ESP32-C6-heart-idf/sdkconfig

src_web/dist/chart.js
ESP32-C6-heart-idf/.cache/clangd

Hardware/temperature_sensor/
